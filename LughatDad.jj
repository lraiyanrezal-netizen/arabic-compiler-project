/*todo*/
options {
  UNICODE_INPUT = true;	// allow for unicode and arabic symbols
  STATIC = true;	//it means belongs to the class and not the objects
}

PARSER_BEGIN(LughatDad)
import java.io.*;

public class LughatDad {
  public static void main(String[] args) throws ParseException {
    LughatDad parser = new LughatDad(System.in);
    System.out.println("Reading from standard input...");
    System.out.print("Enter Arabic code: ");
    try {
      parser.Start();
    } catch (Throwable e) {
      System.out.println("Oops.");
      System.out.println(e.getMessage());
    }
  }
}
PARSER_END(LughatDad)

SKIP : {
  " " | "\r" | "\t" | "\n"
  | < "//" (~["\n","\r"])* ("\n"|"\r"|"\r\n")? >
}

/*given skel code */
TOKEN : /* KEYWORDS */
{
  < MUTA_GHAYYER : "متغير" > /* متغير */
  | < ITBA3 : "اطبع" > /* اطبع */
  | < ETHA : "إذا" > /* إذا */
  | < WA_ELLA : "وإلا" > /* وإلا */
  | < BAYNAMA : "بينما" > /* بينما */

  /*add the two missing keywords not  present */
  | <SAH: "صح"> /* صح - true*/
  | <KHATA: "خطأ"> /* خطأ -false*/
}

TOKEN : /* IDENTIFIERS */
{
  // TODO: Define ARABIC_IDENTIFIER using Unicode range ؀-ۿ
  < ARABIC_IDENTIFIER: <ARABIC_LETTER> (<ARABIC_LETTER> | <DIGIT>)* >
| < #ARABIC_LETTER: ["؀"-"ۿ"] >
| < #DIGIT: ["0"-"9"] >
}

TOKEN : /* LITERALS */
{
    // TODO: Define NUMBER (integer and float)
    // TODO: Define STRING
 < NUMBER: (<DIGIT>)+ ( "." (<DIGIT>)+ )? >
 | < STRING: "\"" (~["\"", "\n", "\r"])* "\"" >
}
/*given skel code */

/*todo*/
TOKEN : /* OPERATORS */
{
/*parts from lab 8*/
  < PLUS: "+" >
| < MINUS: "-" >
| < STAR: "*" >
| < SLASH: "/" >

/*todo - new add comparison*/
|< EQ: "==">
|< NEQ: "!=">
|< GTE: ">=">
|< LTE: "<=">
|< GT: ">">
|< LT: "<">
|< ASSIGN: "=">
}

TOKEN : /* PUNCTUATION */
{
/*taken from lab7*/
  < SEMICOLON: ";" >
| < LPAREN: "(" >
| < RPAREN: ")" >
| < LBRACE: "{" >
| < RBRACE: "}" >
}

/* ===================== PART 2: GRAMMAR & PARSER ===================== */

/* Program ::= ( Statement )* EOF */
void Start() : {}
{
  ( Statement() )* <EOF>
}

/* Statement ::= VarDecl | Assignment | PrintStmt | IfStmt | WhileStmt */
void Statement() : {}
{
    VarDecl()
  | Assignment()
  | PrintStmt()
  | IfStmt()
  | WhileStmt()
}

/* VarDecl ::= "متغير" IDENTIFIER [ "=" Expression ] ";" */
void VarDecl() : {}
{
  <MUTA_GHAYYER> <ARABIC_IDENTIFIER> [ <ASSIGN> Expression() ] <SEMICOLON>
}

/* Assignment ::= IDENTIFIER "=" Expression ";" */
void Assignment() : {}
{
  <ARABIC_IDENTIFIER> <ASSIGN> Expression() <SEMICOLON>
}

/* PrintStmt ::= "اطبع" Expression ";" */
void PrintStmt() : {}
{
  <ITBA3> Expression() <SEMICOLON>
}

/* IfStmt ::= "إذا" "(" Condition ")" Block [ "وإلا" Block ] */
void IfStmt() : {}
{
  <ETHA> <LPAREN> Condition() <RPAREN> Block() [ <WA_ELLA> Block() ]
}

/* WhileStmt ::= "بينما" "(" Condition ")" Block */
void WhileStmt() : {}
{
  <BAYNAMA> <LPAREN> Condition() <RPAREN> Block()
}

/* Block ::= "{" ( Statement )* "}" */
void Block() : {}
{
  <LBRACE> ( Statement() )* <RBRACE>
}

/* Condition ::= Expression [ RelOp Expression ] */
void Condition() : {}
{
  Expression() [ RelOp() Expression() ]
}

/* RelOp ::= "==" | "!=" | ">" | "<" | ">=" | "<=" */
void RelOp() : {}
{
  <EQ> | <NEQ> | <GT> | <LT> | <GTE> | <LTE>
}

/* Expression ::= Term ( ("+" | "-") Term )* */
void Expression() : {}
{
  Term() ( ( <PLUS> | <MINUS> ) Term() )*
}

/* Term ::= Factor ( ("*" | "/") Factor )* */
void Term() : {}
{
  Factor() ( ( <STAR> | <SLASH> ) Factor() )*
}

/* Factor ::= NUMBER | STRING | IDENTIFIER | صح | خطأ | "(" Expression ")" | "-" Factor */
void Factor() : {}
{
    <NUMBER>
  | <STRING>
  | <ARABIC_IDENTIFIER>
  | <SAH>
  | <KHATA>
  | <LPAREN> Expression() <RPAREN>
  | <MINUS> Factor()
}
