/*todo*/
TOKEN : /* OPERATORS */
{
/*parts from lab 8*/
  < PLUS: "+" >
| < MINUS: "-" >
| < STAR: "*" >
| < SLASH: "/" >

/*todo - new add comparison*/
|< EQ: "==">
|< NEQ: "!=">
|< GTE: ">=">
|< LTE: "<=">
|< GT: ">">
|< LT: "<">
|< ASSIGN: "=">
}

TOKEN : /* PUNCTUATION */
{
/*taken from lab7*/
  < SEMICOLON: ";" >
| < LPAREN: "(" >
| < RPAREN: ")" >
| < LBRACE: "{" >
| < RBRACE: "}" >
}
