/*todo*/
options {
  UNICODE_INPUT = true;	// allow for unicode and arabic symbols
  STATIC = true;	//it means belongs to the class and not the objects
}

PARSER_BEGIN(LughatDad)
import java.io.*;
import java.util.*;

public class LughatDad {
  static HashMap<String, Object> symbolTable = new HashMap<>();
  interface Expr { Object eval(); }
  static class LitExpr implements Expr {
    final Object v; LitExpr(Object v) { this.v = v; }
    public Object eval() { return v; }
  }
  static class VarExpr implements Expr {
    final String name; VarExpr(String name) { this.name = name; }
    public Object eval() {
      if (!symbolTable.containsKey(name)) throw new RuntimeException("Undefined variable: " + name);
      return symbolTable.get(name);
    }
  }
  static class NegExpr implements Expr {
    final Expr e; NegExpr(Expr e) { this.e = e; }
    public Object eval() { return -((Double) e.eval()); }
  }
  static class BinExpr implements Expr {
    final Expr l, r; final int kind;
    BinExpr(Expr l, Expr r, int kind) { this.l = l; this.r = r; this.kind = kind; }
    public Object eval() {
      Object lv = l.eval(), rv = r.eval();
      if (kind == EQ) return Objects.equals(lv, rv);
      if (kind == NEQ) return !Objects.equals(lv, rv);
      // Extended feature: String Concat
      if(kind == PLUS && (lv instanceof String || rv instanceof String)) {
        return String.valueOf(lv) + String.valueOf(rv);
      }
      if (!(lv instanceof Double) || !(rv instanceof Double))
        throw new RuntimeException("Operators require numbers.");
      double a = (Double) lv, b = (Double) rv;
      switch (kind) {
        case PLUS: return a + b;
        case MINUS: return a - b;
        case STAR: return a * b;
        case SLASH:
          if (b == 0.0) throw new RuntimeException("Division by zero."); 
          return a / b;
        case GT: return a > b;
        case LT: return a < b;
        case GTE: return a >= b;
        case LTE: return a <= b;
        default: throw new RuntimeException("Unknown operator");
      }
    }
  }
  interface Stmt {
    void exec();
  }
  public static void main(String[] args) throws ParseException {
    LughatDad parser = new LughatDad(System.in);
    System.out.println("Reading from standard input...");
    System.out.print("Enter Arabic code: ");
    try {
      List<Stmt> stmts = parser.Start();
      for(Stmt stmt : stmts) {
        stmt.exec();
      }
    } catch (Throwable e) {
      System.out.println("Oops.");
      System.out.println(e.getMessage());
    }
  }
}
PARSER_END(LughatDad)

SKIP : {
  " " | "\r" | "\t" | "\n"
  | < "//" (~["\n","\r"])* ("\n"|"\r"|"\r\n")? >
}

/*given skel code */
TOKEN : /* KEYWORDS */
{
  < MUTA_GHAYYER : "\u0645\u062a\u063a\u064a\u0631" > /* متغير */
  | < ITBA3 : "\u0627\u0637\u0628\u0639" > /* اطبع */
  | < ETHA : "\u0625\u0630\u0627" > /* إذا */
  | < WA_ELLA : "\u0648\u0625\u0644\u0627" > /* وإلا */
  | < BAYNAMA : "\u0628\u064a\u0646\u0645\u0627" > /* بينما */
  | < LIKUL : "\u0644\u0643\u0644" > /* لكل */


  /*add the two missing keywords not  present */
  | <SAH: "\u0635\u062d"> /* صح - true*/
  | <KHATA: "\u062e\u0637\u0623"> /* خطأ -false*/
}

TOKEN : /* IDENTIFIERS */
{
  // TODO: Define ARABIC_IDENTIFIER using Unicode range \u0600-\u06ff
  < ARABIC_IDENTIFIER: <ARABIC_LETTER> (<ARABIC_LETTER> | <DIGIT>)* >
| < #ARABIC_LETTER: ["\u0600"-"\u06ff"] >
| < #DIGIT: ["0"-"9"] >
}

TOKEN : /* LITERALS */
{
    // TODO: Define NUMBER (integer and float)
    // TODO: Define STRING
 < NUMBER: (<DIGIT>)+ ( "." (<DIGIT>)+ )? >
 | < STRING: "\"" (~["\"", "\n", "\r"])* "\"" >
}
