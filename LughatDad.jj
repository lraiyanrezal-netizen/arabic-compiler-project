{
/*taken from lab7*/
  < SEMICOLON: ";" >
| < LPAREN: "(" >
| < RPAREN: ")" >
| < LBRACE: "{" >
| < RBRACE: "}" >
}

/* ===================== PART 2: GRAMMAR & PARSER ===================== */

/* Program ::= ( Statement )* EOF */
List<Stmt> Start() : 
{
  List<Stmt> stmts = new ArrayList<Stmt>();
  Stmt s;
}
{
  ( s = Statement() { stmts.add(s); } )* <EOF>
  { return stmts; }
}

/* Statement ::= VarDecl | Assignment | PrintStmt | IfStmt | WhileStmt */
Stmt Statement() :
{ Stmt s; }
{
  (
    s = VarDecl()
  | s = Assignment()
  | s = PrintStmt()
  | s = IfStmt()
  | s = WhileStmt()
  )
  { return s; }
}

/* VarDecl ::= "متغير" IDENTIFIER [ "=" Expression ] ";" */
Stmt VarDecl() : 
{ final Token id; Expr e = null; }
{
  <MUTA_GHAYYER> id = <ARABIC_IDENTIFIER> [ <ASSIGN> e = Expression() ] <SEMICOLON> 
  {
    final Expr finalExpr = e;
    return new Stmt() {
      public void exec() {
        symbolTable.put(id.image, finalExpr != null ? finalExpr.eval() : null);
      }
    };
  }
}

/* Assignment ::= IDENTIFIER "=" Expression ";" */
Stmt Assignment() : 
{ Token id; Expr e; }
{
  id = <ARABIC_IDENTIFIER> <ASSIGN> e = Expression() <SEMICOLON>
  {
    return new Stmt() {
      public void exec() {
        if(symbolTable.containsKey(id.image)) {
          symbolTable.put(id.image, e.eval());
        } else {
          throw new RuntimeException("Variable " + id.image + " must be declared first.");
        }
      }
    };
  }
}

/* PrintStmt ::= "اطبع" Expression ";" */
Stmt PrintStmt() : 
{ final Expr e; }
{
  <ITBA3> e = Expression() <SEMICOLON>
  {
    return new Stmt() {
      public void exec() {
        System.out.println(e.eval());
      }
    };
  }
}

/* IfStmt ::= "إذا" "(" Condition ")" Block [ "وإلا" Block ] */
Stmt IfStmt() : 
{ final Expr cond; final Stmt ifBody; Stmt elseBody = null;  }
{
  <ETHA> <LPAREN> cond = Condition() <RPAREN> ifBody = Block() [ <WA_ELLA> elseBody = Block() ]
  {
    final Stmt finalElse = elseBody;
    return new Stmt() {
      public void exec() {
        if(Boolean.TRUE.equals(cond.eval())) {
          ifBody.exec();
        } else {
          if(finalElse != null ) finalElse.exec();
        }
      }
    };
  }
}

/* WhileStmt ::= "بينما" "(" Condition ")" Block */
Stmt WhileStmt() : 
{ final Expr cond; final Stmt body; }
{
  <BAYNAMA> <LPAREN> cond = Condition() <RPAREN> body = Block()
  {
    return new Stmt() {
      public void exec() {
        while(Boolean.TRUE.equals(cond.eval())) {
          body.exec();
        }
      }
    };
  }
}

/* ForStmt ::= "لكل" "(" VarDecl ";" Condition ";" Assignment ")" Block */
Stmt ForStmt() :
{ final Stmt declaration, assignment, body; final Expr cond; }
{
  <LIKUL> <LPAREN> declaration = VarDecl() <SEMICOLON> cond = Condition() <SEMICOLON> assignment = Assignment() <RPAREN> body = Block()
  {
    return new Stmt() {
      public void exec() {
        declaration.exec();
        while(Boolean.TRUE.equals(cond.eval())) {
          body.exec();
          assignment.exec();
        }
      }
    };
  }
}

/* Block ::= "{" ( Statement )* "}" */
Stmt Block() : 
{
  List<Stmt> stmts = new ArrayList<Stmt>();
  Stmt s;
}
{
  <LBRACE> ( s = Statement() { stmts.add(s); } )* <RBRACE>
  {
    return new Stmt() {
      public void exec() {
        for(Stmt stmt : stmts) {
          stmt.exec();
        }
      }
    };
  }
}

/* Condition ::= Expression [ RelOp Expression ] */
Expr Condition() :
{ Expr left, right = null; Token op = null; }
{
  left = Expression() [ op = RelOp() right = Expression() ]
  { return (op == null) ? left : new BinExpr(left, right, op.kind); }
}

/* RelOp ::= "==" | "!=" | ">" | "<" | ">=" | "<=" */
Token RelOp() :
{ Token t; }
{
  ( t = <EQ> | t = <NEQ> | t = <GT> | t = <LT> | t = <GTE> | t = <LTE> )
  { return t; }
}

/* Expression ::= Term ( ("+" | "-") Term )* */
Expr Expression() :
{ Expr left, right; Token op; }
{
  left = Term()
  (
    ( op = <PLUS> | op = <MINUS> )
    right = Term()
    { left = new BinExpr(left, right, op.kind); }
  )*
  { return left; }
}

/* Term ::= Factor ( ("*" | "/") Factor )* */
Expr Term() :
{ Expr left, right; Token op; }
{
  left = Factor()
  (
    ( op = <STAR> | op = <SLASH> )
    right = Factor()
    { left = new BinExpr(left, right, op.kind); }
  )*
  { return left; }
}

/* Factor ::= NUMBER | STRING | IDENTIFIER | صح | خطأ | "(" Expression ")" | "-" Factor */
Expr Factor() :
{ Token t; Expr e; }
{
    t = <NUMBER>
    { return new LitExpr(Double.parseDouble(t.image)); }
  | t = <STRING>
    { return new LitExpr(t.image.substring(1, t.image.length() - 1)); }
  | t = <ARABIC_IDENTIFIER>
    { return new VarExpr(t.image); }
  | <SAH>
    { return new LitExpr(Boolean.TRUE); }
  | <KHATA>
    { return new LitExpr(Boolean.FALSE); }
  | <LPAREN> e = Expression() <RPAREN>
    { return e; }
  | <MINUS> e = Factor()
    { return new NegExpr(e); }
}
