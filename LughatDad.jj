/*todo*/
options {
  UNICODE_INPUT = true;	// allow for unicode and arabic symbols
  STATIC = true;	//it means belongs to the class and not the objects
}

PARSER_BEGIN(LughatDad)
import java.io.*;
import java.util.*;

public class LughatDad {
  static HashMap<String, Object> symbolTable = new HashMap<>();
  interface Expr {
    Object eval();
  }
  interface Stmt {
    void exec();
  }
  public static void main(String[] args) throws ParseException {
    LughatDad parser = new LughatDad(System.in);
    System.out.println("Reading from standard input...");
    System.out.print("Enter Arabic code: ");
    try {
      List<Stmt> stmts = parser.Start();
      for(Stmt stmt : stmts) {
        stmt.exec();
      }
    } catch (Throwable e) {
      System.out.println("Oops.");
      System.out.println(e.getMessage());
    }
  }
}
PARSER_END(LughatDad)

SKIP : {
  " " | "\r" | "\t" | "\n"
  | < "//" (~["\n","\r"])* ("\n"|"\r"|"\r\n")? >
}

/*given skel code */
TOKEN : /* KEYWORDS */
{
  < MUTA_GHAYYER : "\u0645\u062a\u063a\u064a\u0631" > /* متغير */
  | < ITBA3 : "\u0627\u0637\u0628\u0639" > /* اطبع */
  | < ETHA : "\u0625\u0630\u0627" > /* إذا */
  | < WA_ELLA : "\u0648\u0625\u0644\u0627" > /* وإلا */
  | < BAYNAMA : "\u0628\u064a\u0646\u0645\u0627" > /* بينما */

  /*add the two missing keywords not  present */
  | <SAH: "\u0635\u062d"> /* صح - true*/
  | <KHATA: "\u062e\u0637\u0623"> /* خطأ -false*/
}

TOKEN : /* IDENTIFIERS */
{
  // TODO: Define ARABIC_IDENTIFIER using Unicode range \u0600-\u06ff
  < ARABIC_IDENTIFIER: <ARABIC_LETTER> (<ARABIC_LETTER> | <DIGIT>)* >
| < #ARABIC_LETTER: ["\u0600"-"\u06ff"] >
| < #DIGIT: ["0"-"9"] >
}

TOKEN : /* LITERALS */
{
    // TODO: Define NUMBER (integer and float)
    // TODO: Define STRING
 < NUMBER: (<DIGIT>)+ ( "." (<DIGIT>)+ )? >
 | < STRING: "\"" (~["\"", "\n", "\r"])* "\"" >
}
/*given skel code */

/*todo*/
TOKEN : /* OPERATORS */
{
/*parts from lab 8*/
  < PLUS: "+" >
| < MINUS: "-" >
| < STAR: "*" >
| < SLASH: "/" >

/*todo - new add comparison*/
|< EQ: "==">
|< NEQ: "!=">
|< GTE: ">=">
|< LTE: "<=">
|< GT: ">">
|< LT: "<">
|< ASSIGN: "=">
}

TOKEN : /* PUNCTUATION */
{
/*taken from lab7*/
  < SEMICOLON: ";" >
| < LPAREN: "(" >
| < RPAREN: ")" >
| < LBRACE: "{" >
| < RBRACE: "}" >
}

/* ===================== PART 2: GRAMMAR & PARSER ===================== */

/* Program ::= ( Statement )* EOF */
List<Stmt> Start() : 
{
  List<Stmt> stmts = new ArrayList<Stmt>();
  Stmt s;
}
{
  ( s = Statement() { stmts.add(s); } )* <EOF>
  { return stmts; }
}

/* Statement ::= VarDecl | Assignment | PrintStmt | IfStmt | WhileStmt */
Stmt Statement() :
{ Stmt s; }
{
  (
    s = VarDecl()
  | s = Assignment()
  | s = PrintStmt()
  | s = IfStmt()
  | s = WhileStmt()
  )
  { return s; }
}

/* VarDecl ::= "متغير" IDENTIFIER [ "=" Expression ] ";" */
Stmt VarDecl() : 
{ Token id; Expr e = null; }
{
  <MUTA_GHAYYER> id = <ARABIC_IDENTIFIER> [ <ASSIGN> e = Expression() ] <SEMICOLON> {
    return new Stmt() {
      public void exec() {
        symbolTable.put(id.image, e != null ? e.eval() : null);
      }
    };
  }
}

/* Assignment ::= IDENTIFIER "=" Expression ";" */
Stmt Assignment() : 
{ Token id; Expr e; }
{
  id = <ARABIC_IDENTIFIER> <ASSIGN> e = Expression() <SEMICOLON>
  {
    return new Stmt() {
      public void exec() {
        if(symbolTable.containsKey(id.image)) {
          symbolTable.put(id.image, e.eval());
        } else {
          throw new RuntimeException("Variable " + id.image + " must be declared first.");
        }
      }
    };
  }
}

/* PrintStmt ::= "اطبع" Expression ";" */
Stmt PrintStmt() : 
{ final Expr e; }
{
  <ITBA3> e = Expression() <SEMICOLON>
  {
    return new Stmt() {
      public void exec() {
        System.out.println(e.eval());
      }
    };
  }
}

/* IfStmt ::= "إذا" "(" Condition ")" Block [ "وإلا" Block ] */
Stmt IfStmt() : 
{ final Expr cond; final Stmt ifBody, elseBody;  }
{
  <ETHA> <LPAREN> cond = Condition() <RPAREN> ifBody = Block() [ <WA_ELLA> elseBody = Block() ]
  {
    return new Stmt() {
      public void exec() {
        if(Boolean.TRUE.equals(cond.eval())) {
          ifBody.exec();
        } else {
          if(elseBody != null ) elseBody.exec();
        }
      }
    };
  }
}

/* WhileStmt ::= "بينما" "(" Condition ")" Block */
Stmt WhileStmt() : 
{ final Expr cond; final Stmt body; }
{
  <BAYNAMA> <LPAREN> cond = Condition() <RPAREN> body = Block()
  {
    return new Stmt() {
      public void exec() {
        while(Boolean.TRUE.equals(cond.eval())) {
          body.exec();
        }
      }
    };
  }
}

/* Block ::= "{" ( Statement )* "}" */
Stmt Block() : 
{
  List<Stmt> stmts = new ArrayList<Stmt>();
  Stmt s;
}
{
  <LBRACE> ( s = Statement() { stmts.add(s); } )* <RBRACE>
  {
    return new Stmt() {
      public void exec() {
        for(Stmt s : stmts) {
          s.exec();
        }
      }
    };
  }
}

/* Condition ::= Expression [ RelOp Expression ] */
Expr Condition() : 
{ Expr left, right = null; Token op = null; }
{
  left = Expression() [ op = RelOp() right = Expression() ]
  {
    if(op == null) return left;
    final Expr lExpr = left, rExpr = right;
    final int kind = op.kind;
    return new Expr() {
      public Object eval() {
        Object l = lExpr.eval(), r = rExpr.eval();

        if(kind == EQ) return Objects.equals(l, r);
        if(kind == NEQ) return !Objects.equals(l, r)

        if(!(l instanceof Double) || !(r instanceof Double)) {
          throw new RuntimeException("Ordering operators (<, >, <=, >=) require numbers.");
        }

        double a = (Double) l;
        double b = (Double) r;

        switch(op.kind) {
          case GT:
            return a > b;
          case LT:
            return a < b;
          case GTE:
            return a >= b;
          case LTE:
            return a <= b;
          default: throw new RuntimeException("Unknown operator");
        }
      }
    };
  }
}

/* RelOp ::= "==" | "!=" | ">" | "<" | ">=" | "<=" */
Token RelOp() : 
{ Token t; }
{
  t = <EQ> | t = <NEQ> | t = <GT> | t = <LT> | t = <GTE> | t = <LTE>
  {
    return t;
  }
}

/* Expression ::= Term ( ("+" | "-") Term )* */
Expr Expression() : 
{ Expr left, right; Token op; }
{
  left = Term()
  (
    ( op = <PLUS> | op = <MINUS> )
    right = Term()
    {
      final Expr l = left, r = right;
      final int kind = op.kind;
      left = new Expr() {
        public Object eval() {
          double a = (Double) l.eval();
          double b = (Double) r.eval();
          return (kind == PLUS) ? (a + b) : (a - b);
        }
      };
    }
  )*
  { return left; }
  // Term() ( ( <PLUS> | <MINUS> ) Term() )*
}

/* Term ::= Factor ( ("*" | "/") Factor )* */
Expr Term() : 
{ Expr left, right; Token op; }
{

  left = Factor()
  (
    ( op = <STAR> | op = <SLASH> )
    right = Factor()
    {
      final Expr l = left, r = right;
      final int kind = op.kind;
      left = new Expr() {
        public Object eval() {
          double a = (Double) l.eval();
          double b = (Double) r.eval();
          return (kind == STAR) ? (a * b) : (a / b);
        }
      };
    } 
  )*
  { return left; }
}

/* Factor ::= NUMBER | STRING | IDENTIFIER | صح | خطأ | "(" Expression ")" | "-" Factor */
Expr Factor() :
{ Token t; Expr e; }
{
    t = <NUMBER>
    {
      final double val = Double.parseDouble(t.image);
      return new Expr() { public Object eval() { return val; } };
    }
  | t = <STRING> 
    {
      final String val = t.image.substring(1, t.image.length() - 1);
      return new Expr() { public Object eval() { return val; } };
    }
  | t = <ARABIC_IDENTIFIER>
    {
      final String name = t.image;
      return new Expr() {
        public Object eval() {
          if(!symbolTable.containsKey(name))
            throw new RuntimeException("Undefined variable: " + name);
          return symbolTable.get(name);
        }
      };
    }
  | <SAH>
    {
      return new Expr() { public Object eval() { return Boolean.TRUE; } };
    }
  | <KHATA>
    {
      return new Expr() { public Object eval() { return Boolean.FALSE; } };
    }
  | <LPAREN> e = Expression() <RPAREN>
    {
      return e;
    }
  | <MINUS> e = Factor()
    {
      final Expr expr = e;
      return new Expr() {
        public Object eval() { return -((Double) expr.eval()); }
      };
    }
}
